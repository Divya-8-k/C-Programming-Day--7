#include <stdio.h>
void swap(int *a, int *b)
{
    int temp;
    temp = *a;
    *a = *b;
    *b = temp;
}
int main()
{
    int num1, num2;
    printf("Enter two numbers: ");
    scanf("%d %d", &num1, &num2);
    printf("\nBefore Swapping:\n");
    printf("num1 = %d, num2 = %d\n", num1, num2);
    swap(&num1, &num2);
    printf("\nAfter Swapping:\n");
    printf("num1 = %d, num2 = %d\n", num1, num2);
    return 0;
}

OUTPUT:

Enter two numbers: 10 20

Before Swapping:
num1 = 10, num2 = 20

After Swapping:
num1 = 20, num2 = 10


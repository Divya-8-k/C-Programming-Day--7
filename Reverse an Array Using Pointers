#include <stdio.h>
int main()
{
    int arr[5], i, temp;
    int *start, *end;
    printf("Enter 5 elements:\n");
    for(i = 0; i < 5; i++)
    {
        scanf("%d", &arr[i]);
    }
    start = arr;
    end = arr + 4;
    while(start < end)
    {
        temp = *start;
        *start = *end;
        *end = temp;
        start++;
        end--;
    }
    printf("Reversed Array:\n");
    for(i = 0; i < 5; i++)
    {
        printf("%d ", arr[i]);
    }

OUTPUT:

Enter 5 elements:
10 20 30 40 50

Reversed Array:
50 40 30 20 10

    return 0;
}
